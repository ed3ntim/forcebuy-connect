{
  "manifest_version": 3,
  "name": "ForceBuy Connect",
  "description": "Passes the Steam sign-in, and if you turn it on the Buff163 sign-in, of this browser to your ForceBuy account.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://login.steampowered.com/*",
    "https://steamcommunity.com/*",
    "https://forcebuy.net/*"
  ],
  "optional_host_permissions": ["https://buff.163.com/*"],
  "action": { "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["https://forcebuy.net/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
